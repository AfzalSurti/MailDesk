DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Must be a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key

# OpenRouter — use these names on Render (email AI + chatbot share the same keys)
OPENROUTER_API_KEY=your-openrouter-key-1,your-openrouter-key-2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEBUG=true
